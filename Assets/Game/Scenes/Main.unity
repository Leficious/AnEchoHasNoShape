--- !u!114 &111671010
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 111671007}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 400ad39bff6c2e04995b3058b46ed8d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnEchoHasNoShape.Interaction.ReadableTextInteractable
  interactionVerb: Read
  text: "Three paths wander into the haze.\r\n\nOne toward still water holding what
    is absent.\r\nOne toward a city, whose walls remember.\r\nOne toward a bell,
    that waits for no hand.\r\n\r\n[important]Beyond the golden gate,  \r\na false
    stone bars the way.\r\nWhat offers no answer  \r\ncannot forbid your passage.[/important]\r\n\r\nFollow
    each path until it has nothing left to tell you.\r\n\r\nWhen no road calls ahead,\nlisten
    for the place that first heard you.\n\nIt may answer differently."
  charactersPerSecond: 48
  unlockEchoAfterFirstRead: 0
  triggerWorldReverberationAfterFirstRead: 1
  openHiddenDoorAfterFirstRead: 1
  checkpointAfterFirstRead: 0
