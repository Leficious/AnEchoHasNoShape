--- !u!114 &415188095
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 415188094}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 400ad39bff6c2e04995b3058b46ed8d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnEchoHasNoShape.Interaction.ReadableTextInteractable
  interactionVerb: Read
  text: 'A dimming light. A fading voice. A land sketched faintly in haze,

    each
    stone certain of itself.


    Reverberation lends shape, to that which has no
    shape,

    and reason to that which has none.


    Follow what returns to you,
    if you must.

    But remember:


    [important]An echo is not the world answering.

    It
    is only your own voice,

    pretending to know the way.[/important]'
  charactersPerSecond: 48
  unlockEchoAfterFirstRead: 1
  triggerWorldReverberationAfterFirstRead: 0
  openHiddenDoorAfterFirstRead: 0
