--- !u!114 &1064756104
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1064756100}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 400ad39bff6c2e04995b3058b46ed8d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnEchoHasNoShape.Interaction.ReadableTextInteractable
  interactionVerb: Read
  text: 'No two eyes remember the same city.

    Each beholds a truth. Each invents
    a lie.

    To see the whole, borrow the sight of others.


    [important]First,
    seek the Muse in blue.

    Then, the Ruler in red.

    Last, the Architect
    in green.[/important]


    Where their visions meet,

    the city shall remember
    itself.'
  charactersPerSecond: 48
  unlockEchoAfterFirstRead: 0
  triggerWorldReverberationAfterFirstRead: 0
  openHiddenDoorAfterFirstRead: 0
  checkpointAfterFirstRead: 0
