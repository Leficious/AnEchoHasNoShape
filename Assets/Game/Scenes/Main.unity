  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnEchoHasNoShape.Echolocation.CityCharacterInteractable
  passage: 'I never knew the hands that raised this arch.

    Still, it shelters
    me.


    I never knew who laid these steps.

    Still, they bear my weight.


    We
    build for those we will not meet.

    They will know us by what remains.


    [important]My
    liege has spoken; I lay the final stone.[/important]'
  charactersPerSecond: 36
  dialogueInitialized: 1
