MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1559496799}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 400ad39bff6c2e04995b3058b46ed8d8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnEchoHasNoShape.Interaction.ReadableTextInteractable
  interactionVerb: Read
  text: 'The sea keeps no faithful road.

    [important]What bears your gaze, may
    not bear your weight.[/important]


    Across the pale, some paths are seen,
    some answered,

    and some only wished into being.


    [important]When sirens''
    songs rise beyond the fog,

    do not mistake their sweetness for direction.[/important]


    The
    song knows what you long to hear.

    It does not know the way.'
  charactersPerSecond: 48
  unlockEchoAfterFirstRead: 0
  triggerWorldReverberationAfterFirstRead: 0
  openHiddenDoorAfterFirstRead: 0
