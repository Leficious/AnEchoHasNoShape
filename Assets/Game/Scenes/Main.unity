--- !u!114 &2011303331
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2011303326}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a68251efa42849aa932346c515ce7bd1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnEchoHasNoShape.Echolocation.CityCharacterInteractable
  passage: 'They name this city by its towers.

    I know it by those who pass beneath
    them.


    Above us, a promise catches the wind.

    Below, a thousand lives
    give it meaning.


    No city stands by stone alone.

    It stands because
    we agree to belong.


    [important]The song has reached my throne; I pass its
    promise to the hands that build.[/important]'
  charactersPerSecond: 36
  dialogueInitialized: 1
